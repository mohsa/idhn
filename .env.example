# Copy to .env and fill in. Never commit the real .env file.

# Preferred: ChatGPT-account auth. Run `codex login` (or, on a headless
# host, `codex login --device-auth`) once on THIS machine, then leave this
# unset -- IDHN mounts ~/.codex/auth.json (read-only, single file) into the
# agent container automatically. Override the path if your auth.json lives
# somewhere else:
# IDHN_CODEX_AUTH_PATH=/path/to/.codex/auth.json

# Alternative: API-key auth (pays API rates instead of your ChatGPT plan).
# Only needed if you're not using `codex login`.
OPENAI_API_KEY=

# Resource limits passed through to the agent container if not set in the
# policy manifest's `limits` section.
IDHN_CPU=2
IDHN_MEMORY=4g

# Which agent adapter to run by default.
IDHN_AGENT=codex
