# Copy to .env and fill in. Never commit the real .env file.

# Required for the Codex adapter to authenticate inside the agent container.
OPENAI_API_KEY=

# Resource limits passed through to the agent container if not set in the
# policy manifest's `limits` section.
IDHN_CPU=2
IDHN_MEMORY=4g

# Which agent adapter to run by default.
IDHN_AGENT=codex
