# Agent container: runs Codex against /workspace only. No direct internet
# access (see docker/compose.yaml -- this service only joins the
# `internal` network) and no host mounts beyond the toy repo.

FROM node:22-slim

# Deliberately narrow package list -- enforcement/process.py's PATH
# restriction only stops BARE command names it doesn't shim; a binary
# still physically present in the image remains invocable by absolute
# path. Not installing curl/wget/openssh-client/nc/etc. here shrinks that
# residual gap; it isn't meant to be the actual boundary (filesystem and
# network enforcement are -- see enforcement/process.py's docstring).
# ripgrep is installed explicitly (not left to whatever Codex happens to
# bundle) so entrypoint.sh's `command -v rg` has a stable, known target.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        git \
        ripgrep \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages pytest

# OpenAI Codex CLI. IDHN invokes it non-interactively via `codex exec`
# (see idhn/adapters/codex.py).
RUN npm install -g @openai/codex

RUN useradd --create-home --shell /bin/bash agent
# Mount point for the host's ~/.codex/auth.json (read-only, single file --
# never the whole ~/.codex or host home directory). See docker/compose.yaml.
RUN mkdir -p /home/agent/.codex && chown agent:agent /home/agent/.codex
# Process enforcement's PATH-restricted binary shim directory, populated
# by entrypoint.sh from IDHN_ALLOWED_BINARIES at container start. See
# idhn/enforcement/process.py.
RUN mkdir -p /opt/idhn/bin && chown agent:agent /opt/idhn/bin
WORKDIR /workspace

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER agent
ENV HOME=/home/agent

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
